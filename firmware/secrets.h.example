#pragma once

// Copia este archivo junto al .ino que vayas a flashear:
//   cp firmware/secrets.h.example firmware/esp32_dht22_http/secrets.h
// y rellena tus datos. secrets.h está en .gitignore.

#define WIFI_SSID   "TU_WIFI"
#define WIFI_PASS   "TU_CLAVE_WIFI"

// IP LAN del computador / servidor donde corre ThingsBoard.
// En Linux: hostname -I | awk '{print $1}'
// No uses "localhost": el ESP32 no es este computador.
#define TB_HOST     "192.168.1.50"
#define TB_PORT     8080
#define TB_TOKEN    "PEGA_AQUI_EL_ACCESS_TOKEN"

// MQTT (solo el sketch esp32_dht22_mqtt).
#define TB_MQTT_PORT 1883

// Pin del sensor. DHT22 y DS18B20 usan el mismo GPIO por defecto.
#define SENSOR_PIN  4

// Segundos entre lecturas. 30 es razonable para temperatura de finca.
#define INTERVAL_S  30
