# Copia este archivo a .env y ajusta solo lo que necesites.
#   cp .env.example .env

# Puertos en el computador / servidor (cámbialos si ya están ocupados).
TB_HTTP_PORT=8080
TB_MQTT_PORT=1883
TB_MQTTS_PORT=8883
TB_EDGE_PORT=7070
TB_COAP_PORT=5683

# Contraseña de la base interna de ThingsBoard (NO es la del login web).
# Cámbiala antes de un despliegue real. Debe coincidir en compose.
POSTGRES_PASSWORD=postgres

# URL que usan los scripts de este repo (bootstrap y sensor virtual).
TB_URL=http://127.0.0.1:8080

# Cuentas demo que crea ThingsBoard con LOAD_DEMO=true.
# Cámbialas en la UI en cuanto abras el sistema a una red.
TB_TENANT_EMAIL=tenant@thingsboard.org
TB_TENANT_PASSWORD=tenant
